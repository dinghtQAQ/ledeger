{
	"name": "ledeger",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "vite build",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:migrations": "node scripts/verify-migrations.mjs",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p test/tsconfig.json",
		"check": "pnpm run typecheck && pnpm run test",
		"cf-typegen": "wrangler types",
		"deploy:dry-run": "wrangler deploy --dry-run"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^5.5.2",
		"vite": "^8.2.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.1",
		"hono": "^4.13.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.5.4"
	}
}
