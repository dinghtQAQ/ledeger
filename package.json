		"deploy:dry-run": "wrangler deploy --dry-run"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@types/node": "^26.4.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.127.1"
	}
}
